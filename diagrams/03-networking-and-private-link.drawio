<mxfile host="app.diagrams.net" agent="architecture-cookbook" version="24.7.0" type="device">
  <diagram id="networking-private-link" name="Networking and Private Link Detail">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Networking Detail - Cross-Tenant Private Connectivity" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1140" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cust_vnet" value="Customer Virtual Network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="480" height="540" as="geometry" />
        </mxCell>
        <mxCell id="prov_vnet" value="Provider Virtual Network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="480" height="540" as="geometry" />
        </mxCell>

        <mxCell id="subnet_app" value="App subnet&lt;br&gt;ISV platform compute (App Service / AKS / VM)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="subnet_pe" value="Private endpoint subnet&lt;br&gt;Private endpoint NIC for the provider's gateway (optional path)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nsg_box" value="NSG - restrict egress to the gateway's private endpoint IP, or public FQDN only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dns_box" value="Private DNS zone (privatelink.azure-api.net) linked to the customer VNet - resolves the gateway FQDN to the private IP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alt_box" value="Alternative: no private endpoint - public gateway endpoint + IP allow-list + TLS 1.2+" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="apim_subnet" value="APIM subnet - v2 tier, VNet-injected, or public with private endpoint enabled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="110" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pls_box" value="Private endpoint / Private Link service on the APIM gateway - the approval workflow accepts connection requests raised from other tenants" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="220" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="foundry_subnet" value="Foundry private endpoint subnet - the gateway reaches Foundry over Private Link within the SAME tenant" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="330" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nat_note" value="NAT applied by Private Link - overlapping RFC1918 ranges across many customer VNets never collide on the provider side" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="430" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="foundry_final" value="Microsoft Foundry account + project - private endpoint only, public network access disabled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="510" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_pe" value="Cross-tenant Private Endpoint connection&#10;(needs manual / API approval by the provider)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=0;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="subnet_pe" target="pls_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_alt" value="Public path: HTTPS + allow-listed IPs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="alt_box" target="apim_subnet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_dns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;exitX=0.5;exitY=0;entryX=0.5;exitY=1;" edge="1" parent="1" source="dns_box" target="subnet_pe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_int1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apim_subnet" target="pls_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_int2" value="same-tenant, managed identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pls_box" target="foundry_subnet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_int3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="foundry_subnet" target="foundry_final"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="Legend&lt;br&gt;&#8226; Blue = customer tenant resources&lt;br&gt;&#8226; Green = provider tenant resources&lt;br&gt;&#8226; Solid green arrow = supported cross-tenant Private Link connection (approval workflow, no VPN, no VNet peering)&lt;br&gt;&#8226; Dashed amber arrow = alternative public-endpoint path (allow-listed IPs, TLS)&lt;br&gt;&#8226; Amber box = operational note to validate at design time" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1120" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
