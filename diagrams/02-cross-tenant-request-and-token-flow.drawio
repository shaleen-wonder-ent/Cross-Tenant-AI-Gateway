<mxfile host="app.diagrams.net" agent="architecture-cookbook" version="24.7.0" type="device">
  <diagram id="cross-tenant-request-token-flow" name="Cross-Tenant Request and Token Flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Cross-Tenant Request and Token Flow - Application in Customer Tenant, Model Consumption in Provider Tenant" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1160" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Identity terminates at the gateway: OAuth2 client-credentials (or subscription key) at the front door, managed identity same-tenant at the back" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#2d7d46;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="26" width="1160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="colA_hdr" value="CUSTOMER TENANT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="colB_hdr" value="CROSS-TENANT BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="colC_hdr" value="PROVIDER TENANT (Marketplace subscription owner)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="380" height="30" as="geometry" />
        </mxCell>

        <!-- Left column -->
        <mxCell id="vnet_container" value="Customer VNet / private subnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacing=6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="340" height="330" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Users&lt;br&gt;Customer employees and provider employees, both signed in with customer Entra IDs&lt;br&gt;Sign-in governed by the CUSTOMER tenant only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="isv_platform" value="ISV platform&lt;br&gt;App-level authZ uses customer Entra ID (who may use the app)&lt;br&gt;Model-call credential is SEPARATE - never the customer identity" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cred_store" value="Client credential store&lt;br&gt;OAuth2 client-credentials (or APIM subscription key)&lt;br&gt;Held in customer Key Vault, scoped to this client only&lt;br&gt;No provider Foundry / Anthropic key ever lands here" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="priv_endpoint" value="Private endpoint (optional)&lt;br&gt;Cross-tenant PE to the provider's gateway - approval workflow&lt;br&gt;Alternative: public endpoint + IP allow-list + TLS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Middle column -->
        <mxCell id="https_box" value="HTTPS + bearer token or subscription key&lt;br&gt;&#10007; Managed identity does NOT work cross-tenant&lt;br&gt;&#10003; Key / OAuth2 client-credentials have no tenant restriction&lt;br&gt;Same shape as calling any external SaaS API" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="identity_claim_box" value="Customer identity carried as a CLAIM&lt;br&gt;x-user-id / custom header passed for attribution and audit only&lt;br&gt;Never used to authenticate against the provider's Foundry" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="network_path_box" value="Network path&lt;br&gt;Private Link over the Azure backbone - cross-tenant private endpoints via approval workflow&lt;br&gt;No VPN, no VNet peering required" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="280" height="110" as="geometry" />
        </mxCell>

        <!-- Right column -->
        <mxCell id="apim_box" value="Azure API Management - AI gateway&lt;br&gt;IDENTITY TERMINATES HERE - validates client credential, resolves caller to a per-client product&lt;br&gt;Token quota + rate limit keyed per client, emits token metrics for chargeback&lt;br&gt;APIM v2 tier required - Anthropic Messages API support for LLM token policies" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mi_box" value="Managed identity to Foundry (SAME-TENANT hop)&lt;br&gt;authentication-managed-identity policy obtains the Entra token for the backend&lt;br&gt;Provider's Foundry / Anthropic key is held by the gateway, or eliminated entirely" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="250" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="foundry_box" value="Microsoft Foundry - resource + project&lt;br&gt;Claude deployment - Global Standard or US Data Zone Standard&lt;br&gt;Marketplace subscription owned by the provider" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="anthropic_box" value="Anthropic-operated inference service&lt;br&gt;Anthropic is seller of record and data processor - non-Microsoft product under Product Terms&lt;br&gt;Prompts / completions leave the customer tenant and geography&lt;br&gt;Confirm current regional availability before committing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- Bottom banner -->
        <mxCell id="bottom_banner" value="Consumption metering to Azure invoice to decrements the owning tenant's Azure commitment and Anthropic commitment&lt;br&gt;Single Claude consumption-unit meter - hourly metering, invoiced monthly in arrears - EA / MCA-E required, confirm CSP support before assuming it's available" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="1090" height="70" as="geometry" />
        </mxCell>

        <!-- Numbered flow edges -->
        <mxCell id="e1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="isv_platform"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="isv_platform" target="cred_store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cred_store" target="priv_endpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="priv_endpoint" target="network_path_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#2d7d46;fontColor=#ffffff;labelBackgroundColor=#2d7d46;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="isv_platform" target="identity_claim_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="network_path_box" target="apim_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apim_box" target="mi_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mi_box" target="foundry_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontColor=#ffffff;labelBackgroundColor=#b85450;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="foundry_box" target="anthropic_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;fontColor=#ffffff;labelBackgroundColor=#9673a6;fontStyle=1;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="anthropic_box" target="bottom_banner"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
