<mxfile host="app.diagrams.net" agent="architecture-cookbook" version="24.7.0" type="device">
  <diagram id="network-architecture" name="Network Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Network Architecture - Customer to APIM to Foundry to Anthropic" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1160" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="No VNet peering under any circumstances - Private Link or a public endpoint are the only two paths in" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cust_vnet" value="Customer Tenant - Virtual Network (customer's own region)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="480" height="540" as="geometry" />
        </mxCell>
        <mxCell id="prov_vnet" value="Provider Tenant - Virtual Network (deployed in a region chosen for THIS customer - tenant is a billing/identity boundary, not a region)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="480" height="540" as="geometry" />
        </mxCell>

        <mxCell id="app_subnet" value="App subnet&lt;br&gt;ISV Platform (AI Force App) - holds OPTION 1 (OAuth2 client credential) OR OPTION 2 (APIM subscription key)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pe_subnet" value="Private endpoint subnet (optional - Private Link path only)&lt;br&gt;Private endpoint NIC targeting APIM's Private Link connection in the Provider Tenant" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="no_peering" value="HARD CONSTRAINT: no VNet peering with the Provider Tenant, under any circumstances" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="nsg_dns" value="NSG restricts egress to only the gateway's private IP (or public FQDN) + Private DNS zone (privatelink.azure-api.net) linked here for the private path" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="public_alt" value="Alternative path: no Private Endpoint - public APIM endpoint + IP allow-list + TLS 1.2+ (customer's egress IPs)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="apim_box" value="Azure API Management (v2 tier)&lt;br&gt;Accepts OPTION 1 (OAuth2 Bearer JWT, validate-jwt) or OPTION 2 (Subscription key) at the front door" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="110" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pl_endpoint" value="Private Link connection endpoint&lt;br&gt;Cross-tenant approval workflow - accepts the customer's connection request, NAT applied, NO peering involved" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="230" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mi_foundry" value="Managed identity to Microsoft Foundry (SAME-TENANT private endpoint)&lt;br&gt;Claude deployment - public network access disabled on Foundry" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="750" y="340" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="anthropic_box" value="Call to Anthropic-operated inference (Claude)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="750" y="450" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="region_note" value="Latency note: model/region availability may still constrain how close this deployment can be to the customer - confirm current supported Claude-on-Foundry regions before committing to a region" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="750" y="540" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_app_pe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="app_subnet" target="pe_subnet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pe_pl" value="Private Link (cross-tenant, approval workflow)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pe_subnet" target="pl_endpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_app_apim_public" value="OR: public endpoint + IP allow-list + TLS (no Private Endpoint needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.15;entryX=0;entryY=0.85;" edge="1" parent="1" source="app_subnet" target="apim_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pl_apim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="pl_endpoint" target="apim_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_apim_mi" value="OPTION 1 or OPTION 2, both validated at APIM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apim_box" target="pl_endpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_mi_foundry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pl_endpoint" target="mi_foundry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_foundry_anthropic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mi_foundry" target="anthropic_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="Legend&lt;br&gt;&#8226; Blue = Customer Tenant resources &#8226; Green = Provider Tenant resources &#8226; Orange = Anthropic-operated / third party &#8226; Red = hard constraint &#8226; Amber = alternative path or note to reconfirm&lt;br&gt;&#8226; Solid green arrow = Private Link (no peering, NAT applied, approval workflow) &#8226; Dashed amber arrow = alternative public-endpoint path" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1160" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
