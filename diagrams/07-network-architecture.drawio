                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_foundry_anthropic" edge="1" parent="1" source="mi_foundry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="anthropic_box">
                    <mxGeometry relative="1" as="geometry"/>
