<mxfile host="65bd71144e">
    <diagram id="network-architecture" name="Network Architecture">
        <mxGraphModel dx="1587" dy="775" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;" value="Network Architecture - Customer to APIM to Foundry to Anthropic" vertex="1">
                    <mxGeometry height="28" width="1160" x="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;fillColor=none;strokeColor=none;" value="No VNet peering under any circumstances - Private Link or a public endpoint are the only two paths in" vertex="1">
                    <mxGeometry height="20" width="1160" x="40" y="26" as="geometry"/>
                </mxCell>
                <mxCell id="cust_vnet" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" value="Customer Tenant - Virtual Network (customer&#39;s own region)" vertex="1">
                    <mxGeometry height="540" width="480" x="40" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="prov_vnet" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" value="Provider Tenant - Virtual Network (deployed in a region chosen for THIS customer - tenant is a billing/identity boundary, not a region)" vertex="1">
                    <mxGeometry height="540" width="480" x="720" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="app_subnet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" value="App subnet&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;ISV Platform (AI Force App) - holds&amp;nbsp;&lt;/div&gt;&lt;div&gt;OPTION 1 (OAuth2 client credential)&amp;nbsp; or&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;OPTION 2 (APIM subscription key)&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="420" x="70" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="pe_subnet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" value="Private endpoint subnet (optional - Private Link path only)&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;Private endpoint NIC targeting APIM&#39;s Private Link connection in the Provider Tenant&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="420" x="70" y="220" as="geometry"/>
                </mxCell>
                <mxCell id="no_peering" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" value="HARD CONSTRAINT: no VNet peering with the Provider Tenant, under any circumstances" vertex="1">
                    <mxGeometry height="60" width="420" x="70" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="nsg_dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" value="NSG restricts egress to only the gateway&#39;s private IP (or public FQDN) + Private DNS zone (privatelink.azure-api.net) linked here for the private path" vertex="1">
                    <mxGeometry height="90" width="420" x="70" y="410" as="geometry"/>
                </mxCell>
                <mxCell id="public_alt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" value="Alternative path: no Private Endpoint - public APIM endpoint + IP allow-list + TLS 1.2+ (customer&#39;s egress IPs)" vertex="1">
                    <mxGeometry height="60" width="420" x="70" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="apim_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" value="Azure API Management (v2 tier)&lt;br&gt;Accepts&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;OPTION 1 (OAuth2 Bearer JWT, validate-jwt) or&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;OPTION 2 (Subscription key) at the front door&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="420" x="750" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="pl_endpoint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" value="Private Link connection endpoint&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;Cross-tenant approval workflow - accepts the customer&#39;s connection request, NAT applied, NO peering involved&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="420" x="750" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="mi_foundry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" value="Managed identity to Microsoft Foundry (SAME-TENANT private endpoint)&lt;br&gt;&lt;br&gt;&lt;div&gt;Claude deployment - public network access disabled on Foundry&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="420" x="750" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="anthropic_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Call to Anthropic-operated inference (Claude)" vertex="1">
                    <mxGeometry height="70" width="420" x="750" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="region_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="Latency note: model/region availability may still constrain how close this deployment can be to the customer - confirm current supported Claude-on-Foundry regions before committing to a region" vertex="1">
                    <mxGeometry height="60" width="420" x="750" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="e_app_pe" edge="1" parent="1" source="app_subnet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="pe_subnet">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_pe_pl" edge="1" parent="1" source="pe_subnet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="pl_endpoint" value="Private Link (cross-tenant, approval workflow)">
                    <mxGeometry relative="1" x="0.037" y="-25" as="geometry">
                        <mxPoint x="-20" y="-10" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_app_apim_public" edge="1" parent="1" source="app_subnet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;fontStyle=2;exitX=1;exitY=0.15;entryX=0;entryY=0.85;" target="apim_box" value="OR: public endpoint + IP allow-list + TLS (no Private Endpoint needed)">
                    <mxGeometry relative="1" x="-0.276" y="24" as="geometry">
                        <mxPoint y="1" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_pl_apim" edge="1" parent="1" source="pl_endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="apim_box">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_apim_mi" edge="1" parent="1" source="apim_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="pl_endpoint" value="OPTION 1 or OPTION 2, both validated at APIM">
                    <mxGeometry relative="1" as="geometry"/>
