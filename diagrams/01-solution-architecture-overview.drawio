<mxfile host="app.diagrams.net" agent="architecture-cookbook" version="24.7.0" type="device">
  <diagram id="solution-architecture-overview" name="Solution Architecture Overview">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Solution Architecture Overview - Cross-Tenant Consumption of Anthropic Models via Microsoft Foundry" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Identity terminates at the gateway: OAuth2 client-credentials (or subscription key) at the front door, managed identity same-tenant at the back" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#2d7d46;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="28" width="1160" height="20" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="colA_hdr" value="CUSTOMER TENANT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="60" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="colB_hdr" value="CROSS-TENANT BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="colC_hdr" value="PROVIDER TENANT (owns the Anthropic-on-Foundry subscription)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="360" height="40" as="geometry" />
        </mxCell>

        <!-- Row labels -->
        <mxCell id="row1_label" value="IDENTITY AND ACCESS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="120" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="row2_label" value="APPLICATION AND NETWORK" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="280" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="row3_label" value="AI PLATFORM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="440" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="row4_label" value="COMMERCIAL AND BILLING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="600" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="row5_label" value="RISK AND GOVERNANCE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="740" width="150" height="170" as="geometry" />
        </mxCell>

        <!-- Row 1: Identity and Access -->
        <mxCell id="r1cA" value="Customer Entra ID - app-level authZ only&lt;br&gt;&#8226; Governs sign-in to the ISV platform only&lt;br&gt;&#8226; Conditional Access / MFA at customer's discretion&lt;br&gt;&#8226; Never used to authenticate against the provider's Foundry resource" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="120" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r1cB" value="Two separate identity domains&lt;br&gt;&#10007; Managed identity does NOT work cross-tenant&lt;br&gt;&#10003; Key / OAuth2 client-credentials have no tenant restriction" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r1cC" value="Provider Entra ID - model-call trust boundary&lt;br&gt;&#8226; Issues the client credential the ISV platform presents to the gateway&lt;br&gt;&#8226; Gateway reaches Foundry with its own managed identity (same-tenant hop)&lt;br&gt;&#8226; Control plane restricted to the provider's platform team" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="360" height="150" as="geometry" />
        </mxCell>

        <!-- Row 2: Application and Network -->
        <mxCell id="r2cA" value="ISV platform (runs in customer VNet)&lt;br&gt;&#8226; Model routing across Claude, GPT and other providers&lt;br&gt;&#8226; Application data stays at rest in the customer tenant&lt;br&gt;&#8226; Holds only the gateway client credential - never a Foundry/Anthropic key" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2cB" value="Private Link over the Azure backbone&lt;br&gt;&#8226; Cross-tenant private endpoint via approval workflow&lt;br&gt;&#8226; NAT applied - overlapping client address spaces do not collide&lt;br&gt;&#8226; Alternative: public endpoint + IP allow-list + TLS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="280" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r2cC" value="Azure API Management - AI gateway (v2 tier)&lt;br&gt;&#8226; Validates the client credential, resolves caller to a per-client product&lt;br&gt;&#8226; Token quota and rate limit keyed per client&lt;br&gt;&#8226; Emits token metrics for chargeback&lt;br&gt;&#8226; v2 tier required for Anthropic Messages API token policies" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="280" width="360" height="150" as="geometry" />
        </mxCell>

        <!-- Row 3: AI Platform -->
        <mxCell id="r3cA" value="Consuming workloads&lt;br&gt;&#8226; Agents / copilots, service-delivery use cases&lt;br&gt;&#8226; See only the gateway endpoint, never the Foundry deployment directly" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="440" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r3cB" value="Single governed egress path&lt;br&gt;&#8226; All inference traffic through one audited, metered route&lt;br&gt;&#8226; Swap-ready: moving a client to a customer-owned model changes only the backend endpoint" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="440" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r3cC" value="Microsoft Foundry - one project per customer engagement&lt;br&gt;&#8226; Managed identity to Foundry (same-tenant hop)&lt;br&gt;&#8226; Claude deployment: Global Standard / US Data Zone Standard&lt;br&gt;&#8226; Anthropic is seller of record and data processor" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="440" width="360" height="150" as="geometry" />
        </mxCell>

        <!-- Row 4: Commercial and Billing -->
        <mxCell id="r4L" value="OPTION A - provider-owned Foundry (pilot / service delivery)&lt;br&gt;&#8226; Marketplace subscription and consumption meter sit in the provider tenant&lt;br&gt;&#8226; Decrements the provider's Azure commitment and Anthropic commitment&lt;br&gt;&#8226; Recovered through the service fee - customer prompts leave the customer tenant, needs explicit data-processing agreement cover" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="600" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r4R" value="OPTION B - customer-owned Foundry (production / scale)&lt;br&gt;&#8226; Customer holds the Anthropic contract and Marketplace subscription&lt;br&gt;&#8226; Decrements the customer's own Azure commitment&lt;br&gt;&#8226; Provider is compensated as channel partner via a multiparty private offer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="600" width="360" height="130" as="geometry" />
        </mxCell>

        <!-- Row 5: Risk and Governance -->
        <mxCell id="r5L" value="CONSTRAINTS TO VALIDATE BEFORE PRODUCTION&lt;br&gt;&#8226; Data residency - confirm current region list with the account team; do not assume country-local deployment is available&lt;br&gt;&#8226; Subscription type - confirm whether CSP is supported for the model at deployment time; this can rule out Option B for some clients&lt;br&gt;&#8226; Existing volume discounts do not automatically carry to consumption-based billing - reconfirm before deploying&lt;br&gt;&#8226; Contractual privity - in Option A the customer's data is processed under the provider's Anthropic agreement (data-processing agreement needed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="160" y="740" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r5R" value="GOVERNANCE POSITION&lt;br&gt;&#8226; OAuth2 client-credentials per client at the front door - rotatable, revocable, better audit trail than a shared key&lt;br&gt;&#8226; Gateway enforces quota isolation so one client's spike cannot starve another&lt;br&gt;&#8226; Quota is provider-managed and 'use it or lose it' - size per engagement, request increases early&lt;br&gt;&#8226; Audit evidence spans two tenants - agree a joint logging and DLP model with the customer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="740" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- Edges row 1 -->
        <mxCell id="e_r1AB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r1cA" target="r1cB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r1BC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r1cB" target="r1cC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Edges row 2 -->
        <mxCell id="e_r2AB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2cA" target="r2cB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r2BC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2cB" target="r2cC"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- Edges row 3 -->
        <mxCell id="e_r3AB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r3cA" target="r3cB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_r3BC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r3cB" target="r3cC"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
