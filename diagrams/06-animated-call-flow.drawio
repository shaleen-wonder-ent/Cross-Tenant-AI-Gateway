<mxfile host="app.diagrams.net" agent="architecture-cookbook" version="24.7.0" type="device">
  <diagram id="animated-call-flow" name="Animated Call Flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Animated Call Flow - Live Request / Response / Metering Path" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1080" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Open this file in draw.io (desktop, app.diagrams.net, or the VS Code Draw.io Integration extension) to see the arrows pulse in the direction of travel" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="36" width="1080" height="20" as="geometry" />
        </mxCell>

        <mxCell id="platform_box" value="ISV Platform&lt;br&gt;(Customer Tenant)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gateway_box" value="Azure API Management&lt;br&gt;AI Gateway (Provider Tenant)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="foundry_box" value="Microsoft Foundry&lt;br&gt;Claude deployment" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="150" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="anthropic_box" value="Anthropic inference service" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="monitor_box" value="Azure Monitor&lt;br&gt;token metrics / chargeback" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- Request path: blue, animated -->
        <mxCell id="req1" value="1. Request + OAuth2 token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#1a73e8;strokeWidth=2;fontSize=9;fontColor=#1a73e8;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="platform_box" target="gateway_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="req2" value="2. Forward with managed-identity token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#1a73e8;strokeWidth=2;fontSize=9;fontColor=#1a73e8;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="gateway_box" target="foundry_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="req3" value="3. Route to Claude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#1a73e8;strokeWidth=2;fontSize=9;fontColor=#1a73e8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="foundry_box" target="anthropic_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Response path: green, animated, reverse direction -->
        <mxCell id="resp1" value="4. Completion + usage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#2d7d46;strokeWidth=2;fontSize=9;fontColor=#2d7d46;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="anthropic_box" target="foundry_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="resp2" value="5. Response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#2d7d46;strokeWidth=2;fontSize=9;fontColor=#2d7d46;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="foundry_box" target="gateway_box"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="resp3" value="6. Response to caller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=4 4;flowAnimation=1;strokeColor=#2d7d46;strokeWidth=2;fontSize=9;fontColor=#2d7d46;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="gateway_box" target="platform_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Async metering path: orange, dotted, animated -->
        <mxCell id="metric1" value="7. Emit token metric (async, dimensioned by client)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;dashPattern=1 3;flowAnimation=1;strokeColor=#d79b00;strokeWidth=2;fontSize=9;fontColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway_box" target="monitor_box"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="Legend&lt;br&gt;&#8226; Blue pulsing arrows = outbound request path (customer tenant to provider tenant to Anthropic)&lt;br&gt;&#8226; Green pulsing arrows = response path back to the caller&lt;br&gt;&#8226; Orange dotted pulsing arrow = asynchronous token-metering / chargeback emission, does not block the response&lt;br&gt;&#8226; Identity note: step 1 uses OAuth2 client-credentials or a subscription key (no tenant restriction); step 2 uses the gateway's own managed identity, which is a same-tenant hop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1000" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
