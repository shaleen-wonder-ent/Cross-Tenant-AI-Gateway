<policies>
    <inbound>
        <base />

        <!--
          1. FRONT DOOR AUTH - terminate identity here.
          Option A: OAuth2 client-credentials (recommended) - validate the JWT issued by the
          provider's multi-tenant Entra ID app registration. Replace tenant-id / audience / issuer.
        -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-scheme="Bearer">
            <openid-config url="https://login.microsoftonline.com/{provider-tenant-id}/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>api://{gateway-app-id}</audience>
            </audiences>
            <issuers>
                <issuer>https://login.microsoftonline.com/{provider-tenant-id}/v2.0</issuer>
            </issuers>
            <required-claims>
                <claim name="roles" match="any">
                    <value>Model.Invoke</value>
                </claim>
            </required-claims>
        </validate-jwt>

        <!-- Resolve the caller to a per-client product/subscription for quota + chargeback -->
        <set-variable name="clientId" value="@(context.Request.Headers.GetValueOrDefault("x-client-id", context.Subscription?.Id ?? "unknown"))" />

        <!-- Attribution only - never used for authentication -->
        <set-variable name="customerUserId" value="@(context.Request.Headers.GetValueOrDefault("x-user-id", "anonymous"))" />

        <!-- 2. Per-client quota isolation - one client cannot exhaust shared Anthropic capacity -->
        <llm-token-limit
            tokens-per-minute="50000"
            counter-key="@((string)context.Variables["clientId"])"
            estimate-prompt-tokens="true"
            tokens-consumed-header-name="x-tokens-consumed"
            remaining-tokens-header-name="x-tokens-remaining" />

        <rate-limit-by-key
            calls="600"
            renewal-period="60"
            counter-key="@((string)context.Variables["clientId"])" />

        <!-- 3. Optional: content safety before forwarding to the model -->
        <!--
        <llm-content-safety backend-id="contentsafety-backend">
            <category name="Hate" threshold="4" />
            <category name="Sexual" threshold="4" />
            <category name="SelfHarm" threshold="4" />
            <category name="Violence" threshold="4" />
        </llm-content-safety>
        -->

        <!-- 4. BACK DOOR AUTH - same-tenant hop, managed identity to Foundry -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />

        <set-backend-service backend-id="foundry-claude-backend" />
    </inbound>

    <backend>
        <forward-request timeout="120" />
    </backend>

    <outbound>
        <base />

        <!-- 5. Token metrics dimensioned per client for chargeback (max 5 dimensions per policy) -->
        <llm-emit-token-metric namespace="ai-gateway">
            <dimension name="ClientId" value="@((string)context.Variables["clientId"])" />
            <dimension name="CustomerUserId" value="@((string)context.Variables["customerUserId"])" />
            <dimension name="API" value="@(context.Api.Name)" />
            <dimension name="Model" value="@(context.Request.Headers.GetValueOrDefault("x-model", "claude"))" />
        </llm-emit-token-metric>
    </outbound>

    <on-error>
        <base />
        <choose>
            <when condition="@(context.LastError.Source == "llm-token-limit")">
                <return-response>
                    <set-status code="429" reason="Token Limit Exceeded" />
                    <set-header name="Retry-After" exists-action="override">
                        <value>60</value>
                    </set-header>
                    <set-body>{"error": "Client token quota exceeded. Try again later."}</set-body>
                </return-response>
            </when>
            <when condition="@(context.LastError.Source == "validate-jwt")">
                <return-response>
                    <set-status code="401" reason="Unauthorized" />
                    <set-body>{"error": "Invalid or missing client credential."}</set-body>
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
