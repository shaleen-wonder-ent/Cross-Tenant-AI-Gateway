tenant_id           = "00000000-0000-0000-0000-000000000000"
subscription_id     = "00000000-0000-0000-0000-000000000000"
customer_tenant_id  = "00000000-0000-0000-0000-000000000000"
publisher_name      = "Platform Engineering"
publisher_email     = "platform@example.com"

location = "eastus2"
prefix   = "aigw-prov"

# APIM StandardV2 cannot be created with public access blocked; create public,
# then flip to false after the cross-tenant private endpoint is approved.
apim_public_network_access_enabled = true

# Private Foundry: private endpoint + APIM outbound VNet integration.
enable_foundry_private_endpoint       = true
foundry_public_network_access_enabled = false

# Claude Haiku 4.5 on Foundry (Hosted on Azure). Confirm model_version in the catalog.
model_name            = "claude-haiku-4-5"
model_deployment_name = "claude-haiku-4-5"
model_format          = "Anthropic"
model_version         = "2"
model_sku_name        = "GlobalStandard"
model_industry        = "Technology"
model_org_name        = "AI Gateway POC"
model_country_code    = "US"

tags = {
  environment = "poc"
  workload    = "cross-tenant-ai-gateway"
}