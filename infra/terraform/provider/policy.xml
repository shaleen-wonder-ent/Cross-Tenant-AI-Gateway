<policies>
    <inbound>
        <base />
        <validate-azure-ad-token tenant-id="${customer_tenant_id}">
            <audiences>
                <audience>${api_audience}</audience>
            </audiences>
            <required-claims>
                <claim name="roles" match="any">
                    <value>${role_value}</value>
                </claim>
            </required-claims>
        </validate-azure-ad-token>
        <authentication-managed-identity resource="https://ai.azure.com" />
        <set-header name="anthropic-version" exists-action="skip">
            <value>${anthropic_version}</value>
        </set-header>
        <set-backend-service base-url="${foundry_anthropic_url}" />
        <rewrite-uri template="/v1/messages" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
